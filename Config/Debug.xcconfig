// Config/Debug.xcconfig
// Debug build settings for OpenRCT2 visionOS

// Preprocessor definitions for visionOS SDK header compatibility
// The visionOS SDK has a bug where CHAR_BIT and various limit macros must be defined
// before any C++ standard library headers are included
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) DEBUG=1 OPENRCT2_IOS=1 __VISIONOS__=1 CHAR_BIT=8 SCHAR_MAX=127 SCHAR_MIN=(-128) UCHAR_MAX=255 SHRT_MAX=32767 SHRT_MIN=(-32768) USHRT_MAX=65535 INT_MAX=2147483647 INT_MIN=(-2147483647-1) UINT_MAX=4294967295U LONG_MAX=9223372036854775807L LONG_MIN=(-9223372036854775807L-1) ULONG_MAX=18446744073709551615UL LLONG_MAX=9223372036854775807LL LLONG_MIN=(-9223372036854775807LL-1) ULLONG_MAX=18446744073709551615ULL

// Product settings
PRODUCT_DISPLAY_NAME = OpenRCT2 Debug
