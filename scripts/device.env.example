# Copy to runtime/device.env (gitignored). Never commit team or UDID.
#   mkdir -p runtime
#   cp scripts/device.env.example runtime/device.env
#
# Then:
#   ./scripts/play-ios-device.sh

# Required for signed device builds. Xcode → Settings → Accounts, or:
#   security find-identity -v -p codesigning
OPENRCT2_DEVELOPMENT_TEAM=

# Optional device selection when OPENRCT2_DEVICE_UDID is unset:
#   auto    prefer iPhone Air, then any iPhone, then any iPad (default)
#   iphone  prefer iPhone Air, then any iPhone
#   ipad    prefer iPad Pro, then any iPad
#   all     install on every connected device
# OPENRCT2_DEVICE_TARGET=auto

# Optional. Pin one device by UDID (used when you do not pass --iphone/--ipad/--all).
# Run: ./scripts/play-ios-device.sh --list
# OPENRCT2_DEVICE_UDID=
